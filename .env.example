# Copy to .env and fill in values. Never commit a real .env.

# --- Core ---
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
# Production (cPanel / Truehost Setup Python App):
# DEBUG=False
# ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# --- Database ---
# Local development (SQLite)
DB_ENGINE=sqlite

# Production MySQL (cPanel env vars — do not hardcode credentials in settings)
# Leave DB_ENGINE unset (or set DB_ENGINE=mysql). Configure in Setup Python App:
# DB_NAME=cpaneluser_dbname
# DB_USER=cpaneluser_dbuser
# DB_PASSWORD=your_mysql_password
# DB_HOST=localhost
# DB_PORT=3306

# --- YouTube (sermons) ---
YOUTUBE_API_KEY=
YOUTUBE_SERMON_CHANNEL_HANDLE=ncngonghills

# --- Email ---
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Media (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Production extras (optional) ---
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
