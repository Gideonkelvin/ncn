# Copy to .env and fill in values. Never commit a real .env.

# --- Core ---
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
# Production (cPanel) example:
# DEBUG=False
# ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# --- Database ---
# Local development
DB_ENGINE=sqlite

# Production / cPanel MySQL (from MySQL Databases in cPanel)
# DB_ENGINE=mysql
# DB_NAME=cpaneluser_dbname
# DB_USER=cpaneluser_dbuser
# DB_PASSWORD=your_mysql_password
# DB_HOST=localhost
# DB_PORT=3306

# --- YouTube (sermons) ---
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_HANDLE=ncngonghills

# --- Email (contact form) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
CONTACT_EMAIL_RECIPIENT=

# --- Media (optional Cloudinary) ---
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# --- Production extras (optional) ---
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true
# SECURE_SSL_REDIRECT=false
