# Copy to .env and fill in values. Never commit .env.

# Django
SECRET_KEY=your-secret-key-here
# Local dev: True | Production (Render): False
DEBUG=True
# Comma-separated hosts, or * (use specific hosts in production when possible)
ALLOWED_HOSTS=localhost,127.0.0.1
# Production (HTTPS): required when DEBUG=False (e.g. https://your-app.onrender.com)
CSRF_TRUSTED_ORIGINS=

# Database (PostgreSQL on Render — paste Internal Database URL from Render dashboard)
# Leave unset locally to use SQLite (db.sqlite3).
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Optional: force SSL redirect (default True when DEBUG=False)
# SECURE_SSL_REDIRECT=True

# CKEditor uploads (relative path under media / Cloudinary)
# CKEDITOR_UPLOAD_PATH=rose-coloured-lens/ckeditor

# Cloudinary (optional — for media uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# YouTube Data API v3 — sermon page (/sermon/)
YOUTUBE_API_KEY=
YOUTUBE_SERMON_CHANNEL_HANDLE=ncngonghills
YOUTUBE_FEED_CACHE_SECONDS=900

# Email (optional)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
