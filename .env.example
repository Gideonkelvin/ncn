# Copy to .env and fill in values. Never commit .env.
# cPanel / production: set DEBUG=False, ALLOWED_HOSTS, CSRF_TRUSTED_ORIGINS,
# and keep the same SECRET_KEY and Cloudinary keys when migrating.

# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
# Comma-separated hosts (production: yourdomain.com,www.yourdomain.com)
ALLOWED_HOSTS=localhost,127.0.0.1

# HTTPS / CSRF (production — required for admin and forms behind SSL)
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# Optional: set SECURE_SSL_REDIRECT=False only for temporary HTTP testing (not for live HTTPS)
# SECURE_SSL_REDIRECT=True

# Database — leave unset for SQLite (db.sqlite3 next to manage.py).
# cPanel MySQL: paste URL from "MySQL Databases" (often mysql://user:pass@localhost/dbname)
# DATABASE_URL=

# CKEditor uploads (relative path under media / Cloudinary)
# CKEDITOR_UPLOAD_PATH=rose-coloured-lens/ckeditor

# Cloudinary (optional — for media uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# YouTube Data API v3 — sermon page (/sermon/)
YOUTUBE_API_KEY=
YOUTUBE_SERMON_CHANNEL_HANDLE=ncngonghills
YOUTUBE_FEED_CACHE_SECONDS=900

# Email (optional)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
